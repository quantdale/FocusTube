// Copy to Secrets.local.xcconfig. Never commit the real file (gitignored).
//
// These values flow into the generated Xcode project via Config/Debug.xcconfig
// and Config/Release.xcconfig (`#include?` this file) and are consumed as:
//
//   GOOGLE_CLIENT_ID          -> Info.plist GIDClientID (GoogleSignIn configure)
//   GOOGLE_REVERSED_CLIENT_ID -> Info.plist CFBundleURLSchemes (OAuth redirect)
//   DEVELOPMENT_TEAM          -> target signing team (automatic signing)
//   YOUTUBE_API_KEY           -> reserved; the app uses OAuth user tokens, not
//                                an API key, so it may stay empty.
//
// Leaving GOOGLE_* empty keeps GoogleSignIn inert by design (typed
// unauthenticated results, no crash).
GOOGLE_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =
YOUTUBE_API_KEY =
DEVELOPMENT_TEAM =
